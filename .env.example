# ---------------------------------------------------------------------------
# Teachers' Day Quiz -- environment configuration
# Copy to `.env.local` and edit. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# The secret host/admin route. The dashboard lives at /<ADMIN_ROUTE_SECRET>.
# Change this to something nobody can guess, and don't advertise it.
# The secret URL is obscurity only -- username/password is still required.
ADMIN_ROUTE_SECRET=event-control-x7k92m

# Host login username.
ADMIN_USERNAME=host

# Host login password. Choose ONE of the two options below.
#
# Option A (recommended) -- store a scrypt hash, never the plaintext:
#   npm run hash-password -- "your-password-here"
# then paste the output into ADMIN_PASSWORD_HASH and leave ADMIN_PASSWORD empty.
ADMIN_PASSWORD_HASH=

# Option B (quick setup, less safe) -- plaintext password. Only used when
# ADMIN_PASSWORD_HASH is empty. Acceptable for a one-day campus event on a
# private host; prefer Option A for anything longer-lived.
ADMIN_PASSWORD=teachersday2026

# Secret used to sign the admin session cookie. MUST be set in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Where the SQLite file is written. Relative paths resolve from the project root.
DATABASE_PATH=data/quiz.db

# Public origin used when rendering the join QR code, e.g. http://192.168.1.20:3000
# Leave empty to auto-detect from the incoming request (works for most setups).
NEXT_PUBLIC_APP_ORIGIN=
